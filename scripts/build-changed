#!/usr/bin/env bash
# Lint every ebuild added or modified since <base-ref>, then build each one in
# its own container (scripts/in-gentoo).
set -euo pipefail

base=${1:?usage: $0 <base-ref>}
cd "$(dirname -- "${BASH_SOURCE[0]}")/.."

mapfile -t ebuilds < <(git diff --name-only --no-renames --diff-filter=AM "$base"...HEAD -- '*/*/*.ebuild')
if (( ${#ebuilds[@]} == 0 )); then
	echo "No changed ebuilds since $base"
	exit 0
fi
mapfile -t pkgs < <(printf '%s\n' "${ebuilds[@]%/*}" | sort -u)

scripts/in-gentoo pkgcheck scan "${pkgs[@]}"

failed=()
for ebuild in "${ebuilds[@]}"; do
	echo "::group::$ebuild"
	scripts/in-gentoo scripts/build "$ebuild" || failed+=("$ebuild")
	echo "::endgroup::"
done

if (( ${#failed[@]} )); then
	printf 'FAILED %s\n' "${failed[@]}" >&2
	exit 1
fi
