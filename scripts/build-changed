#!/usr/bin/env bash
# Lint and build every ebuild added or modified since <base-ref>.
# Meant to run inside scripts/in-gentoo.
set -euo pipefail

base=${1:?usage: $0 <base-ref>}
cd "$(dirname -- "${BASH_SOURCE[0]}")/.."

mapfile -t ebuilds < <(git diff --name-only --no-renames --diff-filter=AM "$base"...HEAD -- '*/*/*.ebuild')
if (( ${#ebuilds[@]} == 0 )); then
	echo "No changed ebuilds since $base"
	exit 0
fi

atoms=()
for ebuild in "${ebuilds[@]}"; do
	pkg=${ebuild%/*}
	file=${ebuild##*/}
	atoms+=("=${pkg%/*}/${file%.ebuild}")
done
mapfile -t pkgs < <(printf '%s\n' "${ebuilds[@]%/*}" | sort -u)

pkgcheck scan "${pkgs[@]}"

# Dependencies missing from ::gentoo keywords or USE are unmasked as needed;
# the overlay packages themselves are always built from source.
emerge --oneshot --verbose --quiet-build=n \
	--autounmask=y --autounmask-continue=y --autounmask-keep-masks=y \
	--usepkg-exclude "${pkgs[*]}" \
	"${atoms[@]}"

# Python packages declare runtime dependencies in their metadata; verify that
# the ebuild pulled all of them in.
if [[ " ${pkgs[*]}" == *" dev-python/"* ]]; then
	python3 -m pip check
fi
